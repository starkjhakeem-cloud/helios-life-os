# ─────────────────────────────────────────────────────────────────────────────
# HELIOS Backend — Environment Variables
# Copy this file to .env and fill in values before running.
# The .env file is excluded from version control — never commit secrets.
#
# Generate a secure JWT secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

APP_NAME=HELIOS
API_VERSION=v1
VERSION=0.1.0

# Set true only in local development to re-raise unhandled exceptions
DEBUG=false
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────────

# Production: replace with your managed PostgreSQL connection string.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Local Docker Compose uses the internal service hostname `db` and overrides the
# connection string in docker-compose.yml.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Security ─────────────────────────────────────────────────────────────────────

# REQUIRED — replace with a strong random value before any non-local deployment.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-in-production

JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default 60 = 1 hour)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for the CORS middleware.
# "*" (default) is safe for a native mobile-only API — no browser policy applies.
# Restrict this when adding a web frontend:
#   CORS_ORIGINS=https://app.helios.io,https://www.helios.io
CORS_ORIGINS=*

# ── AI Provider ───────────────────────────────────────────────────────────────

# "openai" — real OpenAI responses; requires OPENAI_API_KEY below
# "mock"   — deterministic responses, tests/local demos only
AI_PROVIDER=openai
AI_PROVIDER_FALLBACK_ORDER=mock,openai,anthropic
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required only when AI_PROVIDER=openai — never hardcode this value.
OPENAI_API_KEY=

# OpenAI model to use when AI_PROVIDER=openai.
OPENAI_MODEL=gpt-5.5

# Embedding model for Semantic Memory / RAG.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic ────────────────────────────────────────────────────────────────
# Optional fallback provider. Required only when AI_PROVIDER=anthropic or
# anthropic is enabled in AI_PROVIDER_FALLBACK_ORDER.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Required when the real Google OAuth flow is enabled.
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# Leave commented in development — mock connect works without these.
#
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# GOOGLE_OAUTH_APP_REDIRECT_URI=helios://oauth/google
# GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email

# ── Token Encryption ──────────────────────────────────────────────────────────
# Fernet symmetric key for encrypting OAuth access/refresh tokens at rest.
# Leave commented in development — mock connect does not store real tokens.
# REQUIRED before storing real OAuth tokens in the database.
#
# Generate a key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# TOKEN_ENCRYPTION_KEY=
