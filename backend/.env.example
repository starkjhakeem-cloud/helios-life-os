APP_NAME=HELIOS
API_VERSION=v1
VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL — override with db hostname when running outside Docker
DATABASE_URL=postgresql://helios:helios@localhost:5432/helios

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
