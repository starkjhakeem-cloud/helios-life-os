APP_NAME=HELIOS
API_VERSION=v1
VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL — docker-compose overrides this with db hostname automatically
DATABASE_URL=postgresql://helios:helios@localhost:5432/helios

# JWT — generate a new secret for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider — set to "openai" and supply OPENAI_API_KEY to enable GPT-backed responses
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
